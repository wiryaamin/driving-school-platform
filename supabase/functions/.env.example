# ─── Auth Hook Secret ──────────────────────────────────────────────────────────
# Shared signing key between GoTrue and the auth-hook Edge Function.
# Must match [auth.hook.custom_access_token] secrets in supabase/config.toml.
#
# The value MUST use the standard-webhook format: v1,whsec_<base64-key>
# Using the raw base64 value (without the prefix) will fail HMAC verification
# and every sign-in will return 401 Unauthorized.
#
# Generate:
#   openssl rand -base64 32     → gives: mK4Lp2Rx7vNqY8Z0jW3sUeHdFcTbGnOi9AkXm1BpQ2E=
#   Final value:                   v1,whsec_mK4Lp2Rx7vNqY8Z0jW3sUeHdFcTbGnOi9AkXm1BpQ2E=
#
# Local dev:  copy to supabase/functions/.env (gitignored) and restart supabase
# Production: supabase secrets set AUTH_HOOK_SECRET="v1,whsec_<base64-key>"
#             then configure the same value in Dashboard → Authentication → Hooks
AUTH_HOOK_SECRET=v1,whsec_replace-with-openssl-rand-base64-32-output

# ─── Supabase Credentials (auto-injected in Edge Function runtime) ─────────────
# These are provided automatically by Supabase — do NOT set them manually.
# They are listed here only for documentation purposes.
#
# SUPABASE_URL              — your project URL
# SUPABASE_ANON_KEY         — public anon key (safe for client-side)
# SUPABASE_SERVICE_ROLE_KEY — secret key bypassing RLS (server-side only)
# SUPABASE_DB_URL           — direct Postgres connection string

# ─── App URLs (for CORS allowlist in _shared/cors.ts) ─────────────────────────
# Local dev values are already hard-coded in cors.ts.
# Set these for production via: supabase secrets set APP_URL=https://...
APP_URL=https://admin.your-domain.com
STUDENT_APP_URL=https://app.your-domain.com
