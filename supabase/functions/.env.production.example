# ─── Trafikcloud — Production Edge Function Secrets (reference only) ──────────
# Edge Functions never read a committed .env file in production — every value
# below is set on the hosted project via `supabase secrets set` (or the
# Dashboard → Edge Functions → Secrets). This file exists purely as a
# checklist of what "production configured" means; it is not loaded by
# anything at runtime and must never contain real values.
#
#   supabase secrets set KEY="value" --project-ref <production-project-ref>
#
# Verify current state at any time with:
#   supabase secrets list --project-ref <production-project-ref>

# ─── Auth Hook Secret ──────────────────────────────────────────────────────────
# Shared signing key between GoTrue and the auth-hook Edge Function. Must
# match [auth.hook.custom_access_token] configured in Dashboard → Authentication
# → Hooks EXACTLY. Standard-webhook format: v1,whsec_<base64-key>.
#
# BLOCKER (per the Production Environment Audit): the two local dev copies of
# this secret (supabase/.env and supabase/functions/.env) currently hold two
# different values. Before setting this in production, pick one canonical
# value (or generate a fresh one with `openssl rand -base64 32`) and make
# sure it is set identically here and in the Dashboard hook config — this
# repo does not decide that value for you.
AUTH_HOOK_SECRET=v1,whsec_<production-value>

# ─── Worker Secret ─────────────────────────────────────────────────────────────
# Internal auth for cron-triggered workers (communication-worker, event-worker,
# instructor-ical, platform-bootstrap). Not present in any local env file
# found in this repo — generate one (e.g. `openssl rand -base64 32`) before
# production deploy; there is no existing value to reuse.
WORKER_SECRET=<production-value>

# ─── App URLs (CORS allowlist — supabase/functions/_shared/cors.ts) ───────────
APP_URL=https://trafikcloud.se
# OPEN QUESTION: confirm the real student-portal origin if it differs from
# the main app origin — placeholder shown, matching the "app." subdomain
# convention used elsewhere until a final decision is made.
STUDENT_APP_URL=https://app.trafikcloud.se

# ─── Platform Bootstrap ────────────────────────────────────────────────────────
# Gates the first-organization bootstrap flow (platform-bootstrap function).
PLATFORM_BOOTSTRAP_SECRET=<production-value>

# ─── Supabase Credentials (auto-injected in Edge Function runtime) ─────────────
# Provided automatically by Supabase for the linked project — never set these
# manually, and never store SUPABASE_SERVICE_ROLE_KEY in any local file.
#
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY

# ─── Third-Party Integrations ──────────────────────────────────────────────────
# Referenced by deployed functions (bankid-auth, fortnox, stripe-webhook,
# communication-worker, notifications) but absent from every local env file —
# confirm each is actually in scope for the pilot before setting anything.
# Leaving one unset is safe wherever the function has a documented fallback
# (e.g. PERSON_LOOKUP_PROVIDER defaults to 'mock' if unset).
#
# BankID:       BANKID_CLIENT_CERT, BANKID_CLIENT_KEY, BANKID_CA_CERT, BANKID_ENV
# Fortnox:      FORTNOX_CLIENT_ID, FORTNOX_CLIENT_SECRET
# Stripe:       STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
# Twilio:       TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER, TWILIO_WHATSAPP_NUMBER
# Vonage:       VONAGE_API_KEY, VONAGE_API_SECRET
# 46elks:       ELKS_API_USERNAME, ELKS_API_PASSWORD
# Mailjet:      MAILJET_API_KEY, MAILJET_SECRET_KEY
# SendGrid:     SENDGRID_API_KEY
# Resend:       RESEND_API_KEY
# OneSignal:    ONESIGNAL_APP_ID, ONESIGNAL_API_KEY
# Firebase:     FIREBASE_SERVER_KEY
# Meta WhatsApp: META_WHATSAPP_TOKEN, META_PHONE_NUMBER_ID
# Person lookup: PERSON_LOOKUP_PROVIDER (optional — defaults to 'mock')
