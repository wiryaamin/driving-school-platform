# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Application ───────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
VITE_APP_ENV=development
VITE_APP_VERSION=0.0.1

# ─── Student Portal URL ────────────────────────────────────────────────────────
VITE_STUDENT_APP_URL=http://localhost:5174

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to 'true' to enable — all disabled by default
VITE_FEATURE_BANKID=false
VITE_FEATURE_AI_ASSISTANT=false
VITE_FEATURE_CORPORATE_PORTAL=false
VITE_FEATURE_MOBILE_APP=false

# ─── Debug / Development ───────────────────────────────────────────────────────
# Set to 'true' only in local development — NEVER in production or staging.
VITE_ENABLE_QUERY_DEVTOOLS=false
VITE_ENABLE_DEBUG_LOGGING=false
